# Copy this file to .env and set the LLM_* values. Everything else has a default.

# --- LLM: any OpenAI-compatible chat endpoint, cloud or local -----------------------
# The full assistant (/ask) needs a model with tool calling; /documents/ask and /sql/ask do not.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Other providers, for example:
#   AvalAI      LLM_BASE_URL=https://api.avalai.ir/v1                LLM_MODEL=gpt-4o-mini
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1            LLM_MODEL=openai/gpt-4o-mini
#   Ollama      LLM_BASE_URL=http://host.docker.internal:11434/v1    LLM_MODEL=gpt-oss:20b  (or qwen2.5:7b, llama3.1:8b ...)
#   LM Studio   LLM_BASE_URL=http://host.docker.internal:1234/v1     LLM_MODEL=<the loaded model>
# Local servers need no API key. Without Docker use localhost instead of host.docker.internal.

# Reasoning models only (gpt-oss, o-series): low | medium | high. Leave empty for other models.
# The recorded evaluation used high with gpt-oss:20b.
# LLM_REASONING_EFFORT=high

# How sub-agents get structured answers: json_schema (default) or function_calling
# (use function_calling only if the provider does not support response_format).
# LLM_STRUCTURED_OUTPUT=json_schema

# --- Embeddings ------------------------------------------------------------------
# local  = fastembed on CPU, baked into the Docker image, no API calls (default)
# openai = the /embeddings endpoint of the provider above; then also set EMBEDDING_MODEL
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small

LOG_LEVEL=INFO
